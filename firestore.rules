rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication, Admin, Suspension & Privacy
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the current authenticated caller is currently suspended
    // Handles integer millisecond timestamps (0 for indefinite, or future timestamp)
    // as well as Firestore Timestamp objects, while safely verifying existence and field presence.
    function isSuspensionDataActive(suspData) {
      return suspData.isSuspended == true
        && (
          !('suspendedUntil' in suspData)
          || suspData.suspendedUntil == 0
          || (suspData.suspendedUntil is int && suspData.suspendedUntil > request.time.toMillis())
          || (suspData.suspendedUntil is timestamp && suspData.suspendedUntil > request.time)
        );
    }

    function isCallerSuspended() {
      return exists(/databases/$(database)/documents/userSuspensions/$(request.auth.uid))
        && isSuspensionDataActive(get(/databases/$(database)/documents/userSuspensions/$(request.auth.uid)).data);
    }

    // Validates that an adminRoles document is active, not revoked/disabled, and matches one of the allowedRoles
    function hasActiveAdminRoleInDoc(docData, allowedRoles) {
      return (!('enabled' in docData) || docData.enabled == true)
          && (!('isActive' in docData) || docData.isActive == true)
          && ('role' in docData && docData.role in allowedRoles);
    }

    // Trusted project owner bootstrap helper: recognizes strictly the designated owner account
    // by BOTH exact UID and exact email, strictly before the initial Super Admin document is created.
    function isTrustedOwnerBootstrap() {
      return isSignedIn()
        && request.auth.uid == "isBdCPBYupN4SDJZ1yRiSZ8K0FF2"
        && ('email' in request.auth.token)
        && request.auth.token.email == "hamarachitralonline@gmail.com"
        && !isCallerSuspended()
        && !exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }

    // Verifies that the caller has an active, server-controlled administrative session in adminSessions/{uid}
    // where:
    // 1. isActive field strictly exists and equals true (missing, null, false, or non-boolean rejected)
    // 2. lastActivityAt exists and is a valid Firestore timestamp
    // 3. (request.time - lastActivityAt) is strictly less than 4 hours (14,400,000 ms)
    function hasActiveAdminSession() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid))
        && ('isActive' in get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data)
        && (get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.isActive == true)
        && ('lastActivityAt' in get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data)
        && (get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.lastActivityAt is timestamp)
        && (request.time.toMillis() - get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.lastActivityAt.toMillis() < 14400000)
      );
    }

    // Super Admin helper: verifies super_admin role AND active server-side admin session
    function isSuperAdmin() {
      return isSignedIn() && !isCallerSuspended() && hasActiveAdminSession() && (
        ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
         && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin']))
      );
    }

    // Full Administrator helper (SUPER_ADMIN or ADMIN; excludes MODERATOR):
    // Required for user suspension, Blue Tick verification, post promotion/featuring/pinning, villages, and announcements
    function isFullAdmin() {
      return isSignedIn() && !isCallerSuspended() && hasActiveAdminSession() && (
        ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['super_admin', 'admin']) ||
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
         && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin', 'admin']))
      );
    }

    // Moderator or Admin helper (SUPER_ADMIN, ADMIN, or MODERATOR):
    // Permitted for content moderation (hide/restore/approve/reject posts, review reports, write audit logs)
    function isModeratorOrAdmin() {
      return isSignedIn() && !isCallerSuspended() && hasActiveAdminSession() && (
        ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('moderator' in request.auth.token && request.auth.token.moderator == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['super_admin', 'admin', 'moderator']) ||
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
         && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin', 'admin', 'moderator']))
      );
    }

    // Alias for full administrative privileges
    function isAdmin() {
      return isFullAdmin();
    }

    // Active, un-suspended authenticated user
    function isActiveUser() {
      return isSignedIn() && !isCallerSuspended();
    }

    // Strict validation for adding caller to likedBy array and incrementing count by exactly 1
    function isValidLike(beforeData, afterData) {
      return ('likedBy' in afterData && afterData.likedBy is list)
        && ('likesCount' in afterData && afterData.likesCount is int)
        && (
          // Standard case: existing document has likedBy list and likesCount integer
          (('likedBy' in beforeData && beforeData.likedBy is list && 'likesCount' in beforeData && beforeData.likesCount is int)
           && !(request.auth.uid in beforeData.likedBy)
           && (request.auth.uid in afterData.likedBy)
           && afterData.likedBy.size() == beforeData.likedBy.size() + 1
           && afterData.likedBy.toSet().difference(beforeData.likedBy.toSet()) == [request.auth.uid].toSet()
           && beforeData.likedBy.toSet().difference(afterData.likedBy.toSet()) == [].toSet()
           && afterData.likesCount == beforeData.likesCount + 1)
          ||
          // Fallback case: legacy document was created without likedBy/likesCount fields
          ((!('likedBy' in beforeData) || !(beforeData.likedBy is list))
           && afterData.likedBy == [request.auth.uid]
           && afterData.likesCount == 1)
        );
    }

    // Strict validation for removing caller from likedBy array and decrementing count by exactly 1
    function isValidUnlike(beforeData, afterData) {
      return ('likedBy' in beforeData && beforeData.likedBy is list)
        && ('likesCount' in beforeData && beforeData.likesCount is int)
        && ('likedBy' in afterData && afterData.likedBy is list)
        && ('likesCount' in afterData && afterData.likesCount is int)
        && (request.auth.uid in beforeData.likedBy)
        && !(request.auth.uid in afterData.likedBy)
        && afterData.likedBy.size() == beforeData.likedBy.size() - 1
        && beforeData.likedBy.toSet().difference(afterData.likedBy.toSet()) == [request.auth.uid].toSet()
        && afterData.likedBy.toSet().difference(beforeData.likedBy.toSet()) == [].toSet()
        && afterData.likesCount == beforeData.likesCount - 1
        && afterData.likesCount >= 0;
    }

    // User profile documents in the 'users' collection
    match /users/{userId} {
      // Authenticated users can read member profile documents
      allow read: if isSignedIn();

      // Create profile: authenticated owner cannot self-assign admin roles, verification, suspension, or fake counters
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && (!('role' in request.resource.data) || !(request.resource.data.role in ['super_admin', 'admin', 'moderator']))
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
                    && (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false)
                    && (!('followersCount' in request.resource.data) || request.resource.data.followersCount == 0)
                    && (!('followingCount' in request.resource.data) || request.resource.data.followingCount == 0)
                    && (!('postsCount' in request.resource.data) || request.resource.data.postsCount == 0);

      // Update profile:
      // Update profile:
      // 1. Active owner can update explicitly approved user profile fields (cannot touch role, verification, suspension, or counters)
      // 2. Authorized Full Admin (SUPER_ADMIN or ADMIN, NOT MODERATOR) can update suspension and Blue Tick verification fields
      // 3. Super Admin can also update role if needed
      allow update: if (
        (isActiveUser() && request.auth.uid == userId
         && request.resource.data.uid == resource.data.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'username', 'email', 'phoneNumber', 'accountType',
              'isBusinessAccount', 'businessCategory', 'profession', 'jobTitle',
              'education', 'location', 'bio', 'interests', 'avatarUrl',
              'coverUrl', 'website', 'isPrivate', 'updatedAt'
            ]))
        ||
        (isFullAdmin()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isSuspended', 'suspendedUntil', 'suspensionReason', 'isVerified', 'verifiedUpdatedAt', 'verifiedBy', 'role'
            ])
         && (!('role' in request.resource.data.diff(resource.data).affectedKeys())
             || request.resource.data.role in ['member', 'user', 'moderator']))
        ||
        (isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isSuspended', 'suspendedUntil', 'suspensionReason', 'isVerified', 'verifiedUpdatedAt', 'verifiedBy', 'role'
        ]))
      );

      // Profiles cannot be deleted directly
      allow delete: if false;

      // Private Bookmarked / Saved posts subcollection
      match /savedPosts/{savedPostId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isActiveUser() && request.auth.uid == userId && request.resource.data.postId == savedPostId;
        allow update: if false;
      }

      // Following subcollection
      match /following/{targetUserId} {
        allow read: if isSignedIn();
        // Only relationship participants can create (caller must be either the follower owner or the approved target)
        allow create: if isActiveUser() && userId != targetUserId
                      && (request.auth.uid == userId || request.auth.uid == targetUserId);
        allow delete: if isActiveUser() && userId != targetUserId
                      && (request.auth.uid == userId || request.auth.uid == targetUserId);
        allow update: if false;
      }

      // Followers subcollection
      match /followers/{followerUserId} {
        allow read: if isSignedIn();
        // Only relationship participants can create (caller must be either the follower or the followed target)
        allow create: if isActiveUser() && userId != followerUserId
                      && (request.auth.uid == followerUserId || request.auth.uid == userId);
        allow delete: if isActiveUser() && userId != followerUserId
                      && (request.auth.uid == followerUserId || request.auth.uid == userId);
        allow update: if false;
      }

      // Follow Requests subcollection
      match /followRequests/{requesterId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == requesterId);
        // Only the requester can create a request to follow the target user; self-request forbidden
        allow create: if isActiveUser() && request.auth.uid == requesterId && request.auth.uid != userId;
        // Only target owner (accept/reject) or requester (cancel) can delete
        allow delete: if isActiveUser() && userId != requesterId
                      && (request.auth.uid == userId || request.auth.uid == requesterId);
        allow update: if false;
      }

      // Sent follow requests tracking
      match /sentFollowRequests/{targetUserId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == targetUserId);
        // Only the requester can record a sent request; self-request forbidden
        allow create: if isActiveUser() && request.auth.uid == userId && request.auth.uid != targetUserId;
        // Only the requester (cancel) or target (accept/reject) can delete
        allow delete: if isActiveUser() && userId != targetUserId
                      && (request.auth.uid == userId || request.auth.uid == targetUserId);
        allow update: if false;
      }

      // Blocked accounts subcollection
      match /blockedUsers/{blockedUserId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isActiveUser() && request.auth.uid == userId && request.resource.data.blockedUserId == blockedUserId;
        allow update: if false;
      }

      // Muted accounts subcollection
      match /mutedUsers/{mutedUserId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isActiveUser() && request.auth.uid == userId && request.resource.data.mutedUserId == mutedUserId;
        allow update: if false;
      }

      // Favorite accounts subcollection
      match /favorites/{favoriteUserId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isActiveUser() && request.auth.uid == userId && request.resource.data.favoriteUserId == favoriteUserId;
        allow update: if false;
      }

      // In-app notifications subcollection
      match /notifications/{notificationId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create: if isActiveUser()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.recipientId == userId
                      && request.auth.uid != userId
                      && (!('isRead' in request.resource.data) || request.resource.data.isRead == false);
      }
    }

    // Social feed posts collection
    match /posts/{postId} {
      // Members can read posts
      allow read: if isSignedIn();

      // Only active, un-suspended users can publish posts authored by their own UID
      // Initial post cannot inject moderation, featured, promoted, pinned, trending, spoofed Blue Tick, or fake initial counters
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid
                    && (!('isModeratedHidden' in request.resource.data) || request.resource.data.isModeratedHidden == false)
                    && (!('moderationStatus' in request.resource.data) || request.resource.data.moderationStatus in ['APPROVED', 'PENDING'])
                    && !('moderatedBy' in request.resource.data)
                    && !('moderatedAt' in request.resource.data)
                    && !('moderationReason' in request.resource.data)
                    && (!('isPinned' in request.resource.data) || request.resource.data.isPinned == false)
                    && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false)
                    && (!('isPromoted' in request.resource.data) || request.resource.data.isPromoted == false)
                    && (!('isTrendingLabeled' in request.resource.data) || request.resource.data.isTrendingLabeled == false)
                    && (!('impressionsCount' in request.resource.data) || request.resource.data.impressionsCount == 0)
                    && (!('authorIsVerified' in request.resource.data)
                        || request.resource.data.authorIsVerified == false
                        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true))
                    && (!('likesCount' in request.resource.data) || request.resource.data.likesCount == 0)
                    && (!('likedBy' in request.resource.data) || request.resource.data.likedBy.size() == 0)
                    && (!('commentsCount' in request.resource.data) || request.resource.data.commentsCount == 0)
                    && (!('sharesCount' in request.resource.data) || request.resource.data.sharesCount == 0)
                    && (!('repostsCount' in request.resource.data) || request.resource.data.repostsCount == 0);

      // Update post:
      // 1. Author can edit permitted content fields (authorId, postId, counters, moderation, promotion cannot be altered)
      // 2. Active users can toggle their own like: validated via isValidLike/isValidUnlike
      // 3. Active users can increment/decrement commentsCount by exactly 1 when adding/deleting comments
      // 4. Active users can increment sharesCount / repostsCount by exactly 1 when sharing/reposting
      // 5. Moderators & Admins can moderate content (hide/restore/approve/reject)
      // 6. Full Admins (SUPER_ADMIN or ADMIN) can pin, feature, trend-label, promote, and sync authorIsVerified
      allow update: if isActiveUser() && (
        // Case 1: Post author editing permitted content fields (moderation & promotion fields strictly forbidden)
        (resource.data.authorId == request.auth.uid
         && request.resource.data.authorId == resource.data.authorId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'mediaUrls', 'tags', 'normalizedTags', 'type', 'location',
              'authorBio', 'authorAvatarUrl', 'authorName', 'authorUsername',
              'isPrivate', 'authorIsPrivate', 'updatedAt', 'isEdited', 'editedAt', 'repostThoughts'
            ]))
        ||
        // Case 2: Liking/unliking strictly validated for caller UID and single count delta
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])
         && (isValidLike(resource.data, request.resource.data) || isValidUnlike(resource.data, request.resource.data)))
        ||
        // Case 3: Comment count increment/decrement by 1
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
         && (request.resource.data.commentsCount == resource.data.commentsCount + 1
             || request.resource.data.commentsCount == resource.data.commentsCount - 1))
        ||
        // Case 4: Share / repost count increments
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount'])
         && request.resource.data.sharesCount == resource.data.sharesCount + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostsCount', 'sharesCount'])
         && request.resource.data.repostsCount == resource.data.repostsCount + 1
         && request.resource.data.sharesCount == resource.data.sharesCount + 1)
        ||
        // Case 5: Moderators & Admins moderating content
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isModeratedHidden', 'moderationStatus', 'moderatedAt', 'moderatedBy', 'moderationReason'
        ]) && isModeratorOrAdmin())
        ||
        // Case 6: Full Admins pinning, featuring, trend-labeling, promoting, or syncing authorIsVerified
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isModeratedHidden', 'moderationStatus', 'moderatedAt', 'moderatedBy', 'moderationReason',
          'isPinned', 'isFeatured', 'featuredScheduledAt', 'featuredUntil',
          'isTrendingLabeled', 'isPromoted', 'promotionStartDate', 'promotionEndDate',
          'promotionTargetCategory', 'promotionTargetLocation', 'authorIsVerified'
        ]) && isFullAdmin())
      );

      // Only the author (if not suspended) or an authorized moderator/admin can delete
      allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid) || isModeratorOrAdmin();

      // Threaded Comments and Replies subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid
                      && (!('authorIsVerified' in request.resource.data)
                          || request.resource.data.authorIsVerified == false
                          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true))
                      && (!('likesCount' in request.resource.data) || request.resource.data.likesCount == 0)
                      && (!('likedBy' in request.resource.data) || request.resource.data.likedBy.size() == 0);

        // Update comment:
        // 1. Author can edit text/edit metadata (cannot change authorId, id, authorIsVerified, etc.)
        // 2. Active users can toggle like on comment (validated via isValidLike/isValidUnlike)
        allow update: if isActiveUser() && (
          (resource.data.authorId == request.auth.uid
           && request.resource.data.authorId == resource.data.authorId
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt']))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])
           && (isValidLike(resource.data, request.resource.data) || isValidUnlike(resource.data, request.resource.data)))
        );

        allow delete: if (isActiveUser() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid)) || isModeratorOrAdmin();
      }
    }

    // Root notifications collection (fallback for legacy or direct mention documents)
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if isActiveUser()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.recipientId != request.auth.uid
                    && (!('isRead' in request.resource.data) || request.resource.data.isRead == false);
    }

    // Ephemeral stories collection
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid
                    && (!('isModeratedHidden' in request.resource.data) || request.resource.data.isModeratedHidden == false)
                    && !('moderatedBy' in request.resource.data);
      // Author can update caption; admin can ONLY update approved moderation fields
      allow update: if (isActiveUser() && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'isModeratedHidden', 'moderatedAt', 'moderatedBy', 'moderationReason'
                       ]));
      allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // Short-form Reels collection
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid
                    && (!('isModeratedHidden' in request.resource.data) || request.resource.data.isModeratedHidden == false)
                    && !('moderatedBy' in request.resource.data)
                    && (!('likesCount' in request.resource.data) || request.resource.data.likesCount == 0)
                    && (!('likedBy' in request.resource.data) || request.resource.data.likedBy.size() == 0);
      // Reel authors CANNOT modify moderation fields (isModeratedHidden restricted to admin)
      allow update: if (isActiveUser() && (
        (resource.data.authorId == request.auth.uid
         && request.resource.data.authorId == resource.data.authorId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'tags']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])
         && (isValidLike(resource.data, request.resource.data) || isValidUnlike(resource.data, request.resource.data)))
      )) || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isModeratedHidden', 'moderatedAt', 'moderatedBy', 'moderationReason'
      ]));
      allow delete: if (isActiveUser() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // Private one-to-one messaging conversations
    match /conversations/{conversationId} {
      // Authenticated users can read if they are in participantIds
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds);

      // Create conversation: active user, must be a participant, exactly 2 distinct participants
      allow create: if isActiveUser()
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && (request.auth.uid in request.resource.data.participantIds)
                    && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
                    && (!('id' in request.resource.data) || request.resource.data.id == conversationId);

      // Update conversation metadata: active user and existing participant
      // Strictly restrict updates to approved metadata fields; participant IDs and conversation identity are immutable
      allow update: if isActiveUser()
                    && (request.auth.uid in resource.data.participantIds)
                    && request.resource.data.participantIds == resource.data.participantIds
                    && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp',
                         'readBy', 'participantProfiles', 'id', 'participantIds'
                       ])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageSenderId'])
                        || request.resource.data.lastMessageSenderId == request.auth.uid);

      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // Message sender must be authenticated caller, message must have string text, and sender must be in conversation
        allow create: if isActiveUser()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && (!('id' in request.resource.data) || request.resource.data.id == messageId)
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // Messages cannot be edited or modified after sending
        allow update: if false;

        allow delete: if false;
      }
    }

    // Business & Services listings
    match /businessListings/{listingId} {
      allow read: if isSignedIn();

      allow create: if isActiveUser()
                    && request.resource.data.ownerId == request.auth.uid
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
                    && (!('rating' in request.resource.data) || request.resource.data.rating == 0 || request.resource.data.rating == 0.0)
                    && (!('reviewsCount' in request.resource.data) || request.resource.data.reviewsCount == 0);

      // Owner can update business details; cannot modify ownerId, verification, or rating metrics
      // Admin can update verification, status, and moderation fields
      allow update: if (
        (isActiveUser()
         && resource.data.ownerId == request.auth.uid
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'businessName', 'category', 'categoryDisplayName', 'serviceHighlight',
              'description', 'location', 'phone', 'whatsapp', 'priceRange',
              'status', 'portfolioImages', 'ownerName', 'owner', 'updatedAt'
            ]))
        ||
        (isAdmin()
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isVerified', 'status', 'rating', 'reviewsCount',
              'moderatedAt', 'moderatedBy', 'moderationReason'
            ]))
      );

      allow delete: if (isActiveUser() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // Buy & Sell Marketplace listings
    match /marketplaceListings/{listingId} {
      allow read: if isSignedIn();

      allow create: if isActiveUser()
                    && request.resource.data.sellerId == request.auth.uid
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);

      // Seller can update item details; cannot modify sellerId or administrative verification
      // Admin can update verification, status, and moderation fields
      allow update: if (
        (isActiveUser()
         && resource.data.sellerId == request.auth.uid
         && request.resource.data.sellerId == resource.data.sellerId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'category', 'categoryDisplayName', 'price', 'description',
              'phone', 'whatsapp', 'location', 'condition', 'status',
              'imageUrls', 'sellerName', 'seller', 'updatedAt'
            ]))
        ||
        (isAdmin()
         && request.resource.data.sellerId == resource.data.sellerId
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isVerified', 'status', 'moderatedAt', 'moderatedBy', 'moderationReason'
            ]))
      );

      allow delete: if (isActiveUser() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // Admin roles collection:
    // - Initial bootstrap: Trusted owner can ONLY CREATE their own document (adminRoles/isBdCPBYupN4SDJZ1yRiSZ8K0FF2).
    //   Cannot create, update, or delete any other user's document.
    // - Post-bootstrap: Only an established Super Admin with active server session can create, update, or delete roles.
    match /adminRoles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isModeratorOrAdmin());

      // Create: Super Admin, OR strictly trusted owner creating their own initial document during bootstrap
      allow create: if (
        isSuperAdmin() ||
        (isTrustedOwnerBootstrap() && request.auth.uid == userId && userId == "isBdCPBYupN4SDJZ1yRiSZ8K0FF2")
      );

      // Update: Restricted strictly to established Super Admins (bootstrap cannot update any document)
      allow update: if isSuperAdmin();

      // Delete: Restricted strictly to established Super Admins (bootstrap cannot delete any document)
      allow delete: if isSuperAdmin();
    }

    // Server-controlled administrative sessions collection:
    // Enforces sliding 4-hour inactivity lifetime, requires server timestamps (request.time),
    // and prevents token replay attacks and forged session heartbeats.
    match /adminSessions/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
         && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin']))
      );

      // Create session on login:
      // Must be caller's own UID, must hold an authorized role, must use server timestamp for lastActivityAt.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !isCallerSuspended()
        && (
          (isTrustedOwnerBootstrap() && request.auth.uid == "isBdCPBYupN4SDJZ1yRiSZ8K0FF2") ||
          (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
           && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin', 'admin', 'moderator']))
        )
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && request.resource.data.isActive == true
        && request.resource.data.lastActivityAt == request.time;

      // Update session:
      // Case 1: Invalidation on logout (isActive set to false)
      // Case 2: Sliding activity update (lastActivityAt set to request.time, only if session is currently active and within 4h)
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !isCallerSuspended()
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && (
          (request.resource.data.isActive == false)
          ||
          (
            request.resource.data.isActive == true
            && request.resource.data.lastActivityAt == request.time
            && (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
                && hasActiveAdminRoleInDoc(get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data, ['super_admin', 'admin', 'moderator']))
            && resource.data.isActive == true
            && (request.time.toMillis() - resource.data.lastActivityAt.toMillis() < 14400000)
          )
        );

      // Delete: only Super Admin can delete session documents
      allow delete: if isSuperAdmin();
    }

    // Blue Tick Verification Requests collection (approval/rejection restricted to Full Admin)
    match /verificationRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isModeratorOrAdmin());
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null)
                    && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null);
      allow update: if isFullAdmin()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'reviewedAt', 'reviewedBy', 'reviewNotes'
                       ]);
      allow delete: if isSuperAdmin();
    }

    // Yarkhoon Villages & Locations directory (write restricted to Full Admin)
    match /villages/{villageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFullAdmin();
    }

    // Official Yarkhoon Announcements & Emergency Broadcasts (write restricted to Full Admin)
    match /officialAnnouncements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFullAdmin();
    }

    // Curated Trending Topics (write restricted to Full Admin)
    match /trendingTopics/{topicId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFullAdmin();
    }

    // Content Reports collection (Moderators and Admins can review/resolve reports)
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isModeratorOrAdmin());

      allow create: if isActiveUser()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null)
                    && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null)
                    && (!('resolutionNotes' in request.resource.data) || request.resource.data.resolutionNotes == null);

      // Moderator/Admin updates restricted to moderation and resolution fields; original report details and reporter identity immutable
      allow update: if isModeratorOrAdmin()
                    && request.resource.data.reporterId == resource.data.reporterId
                    && request.resource.data.reportedUserId == resource.data.reportedUserId
                    && request.resource.data.contentId == resource.data.contentId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'reviewedAt', 'reviewedBy', 'resolutionNotes'
                       ]);

      allow delete: if false;
    }

    // Moderation Audit Logs collection (append-only for Moderators and Admins; never modifiable or deletable)
    match /moderationAuditLogs/{logId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // User Suspensions collection: write restricted strictly to Full Admin (Moderators cannot suspend/reinstate users)
    match /userSuspensions/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isModeratorOrAdmin());
      allow write: if isFullAdmin();
    }

    // ==========================================
    // Yarkhoon Madad Center Rules
    // ==========================================

    // 1. Job Seeker Profiles
    match /madadJobProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isActiveUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 2. Job Vacancies
    match /madadJobVacancies/{vacancyId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.postedBy.id == request.auth.uid && request.resource.data.status == 'open';
      allow update: if (isActiveUser() && resource.data.postedBy.id == request.auth.uid) || isAdmin();
      allow delete: if (isActiveUser() && resource.data.postedBy.id == request.auth.uid) || isAdmin();
    }

    // 3. Blood Donors
    match /madadBloodDonors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isActiveUser() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 4. Urgent Blood Requests
    match /madadBloodRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser() && request.resource.data.requester.id == request.auth.uid && request.resource.data.status == 'urgent_active';
      allow update: if (isActiveUser() && resource.data.requester.id == request.auth.uid) || isAdmin();
      allow delete: if (isActiveUser() && resource.data.requester.id == request.auth.uid) || isAdmin();
    }

    // 5. Community Aid Requests
    // Anti-fraud: Requesters cannot self-certify verificationStatus on creation.
    // Only administrators or moderators can change verificationStatus to 'verified_by_moderator'.
    match /madadAidRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isActiveUser()
                    && request.resource.data.requester.id == request.auth.uid
                    && request.resource.data.verificationStatus == 'pending_review';
      allow update: if ((isActiveUser() && resource.data.requester.id == request.auth.uid && request.resource.data.verificationStatus == resource.data.verificationStatus) || isAdmin());
      allow delete: if (isActiveUser() && resource.data.requester.id == request.auth.uid) || isAdmin();
    }

    // 6. Confidential Legal Inquiries: Private 1-on-1 consultations
    match /madadLegalInquiries/{inquiryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isActiveUser() && resource.data.userId == request.auth.uid);
    }
  }
}

